# 既存RG/VNet取得
data "azurerm_resource_group" "rg" {
  name = var.rg_name
}

data "azurerm_virtual_network" "vnet" {
  name                = var.vnet_name
  resource_group_name = data.azurerm_resource_group.rg.name
}

# AD用Subnet（新規）
resource "azurerm_subnet" "ad" {
  name                 = var.ad_subnet_name
  resource_group_name  = data.azurerm_resource_group.rg.name
  virtual_network_name = data.azurerm_virtual_network.vnet.name
  address_prefixes     = [var.ad_subnet_cidr]
}

# BastionSubnet（既存の想定）を参照（存在しない場合は plan で落ちる→Step2-1-4で確認）
data "azurerm_subnet" "bastion" {
  name                 = "AzureBastionSubnet"
  resource_group_name  = data.azurerm_resource_group.rg.name
  virtual_network_name = data.azurerm_virtual_network.vnet.name
}

# NSG（RDPは BastionSubnet のみ許可）
resource "azurerm_network_security_group" "nsg" {
  name                = "nsg-${var.vm_name}"  location            = data.azurerm_resource_group.rg.location  resource_group_name = data.azurerm_resource_group.rg.name  security_rule {    name                       = "Allow-RDP-From-BastionSubnet"    priority                   = 100    direction                  = "Inbound"    access                     = "Allow"    protocol                   = "Tcp"    source_port_range          = "*"    destination_port_range     = "3389"    source_address_prefix      = data.azurerm_subnet.bastion.address_prefixes[0]    destination_address_prefix = "*"  }  security_rule {    name                       = "Deny-All-Inbound"    priority                   = 4096    direction                  = "Inbound"    access                     = "Deny"    protocol                   = "*"    source_port_range          = "*"    destination_port_range     = "*"    source_address_prefix      = "*"    destination_address_prefix = "*"  }}# NIC（Privateのみ）resource "azurerm_network_interface" "nic" {  name                = "nic-${var.vm_name}"  location            = data.azurerm_resource_group.rg.location  resource_group_name = data.azurerm_resource_group.rg.name  ip_configuration {    name                          = "ipconfig1"    subnet_id                     = azurerm_subnet.ad.id    private_ip_address_allocation = "Dynamic"  }}# NIC にNSG紐付けresource "azurerm_network_interface_security_group_association" "assoc" {  network_interface_id      = azurerm_network_interface.nic.id  network_security_group_id = azurerm_network_security_group.nsg.id}# Windows Server 2022 VMresource "azurerm_windows_virtual_machine" "vm" {  name                = var.vm_name  location            = data.azurerm_resource_group.rg.location  resource_group_name = data.azurerm_resource_group.rg.name  size                = var.vm_size  admin_username      = var.admin_username  admin_password      = var.admin_password  network_interface_ids = [azurerm_network_interface.nic.id]  os_disk {